# Environment
COMPOSE_PROJECT_NAME=photo-ai

# Orchestrator
ORCHESTRATOR_PORT=8090
DATA_DIR=/data
LOG_LEVEL=info

# Pipeline defaults (Phase 2+)
REMBG_MODEL=u2net_cloth_seg
PIPELINE_UPSCALE=2
PIPELINE_DENOISE=0.30
PIPELINE_MODE=full
# full | deterministic (skips ComfyUI)

# ComfyUI (Phase 4+)
COMFYUI_PORT=8188
COMFYUI_URL=http://comfyui:8188
# Hybrid Mac dev: COMFYUI_URL=http://host.docker.internal:8188
WORKFLOW_POLISH_PATH=/workflows/polish_catalog.json
COMFYUI_TIMEOUT_SEC=120

# SD defaults
SD_CHECKPOINT=realisticVision_v51.safetensors
SD_STEPS=20
SD_CFG=7
SD_SAMPLER=dpmpp_2m_sde
SD_SEED=-1

# Redis (Phase 6+)
REDIS_URL=redis://redis:6379/0
MAX_CONCURRENT_JOBS=1
JOB_TTL_DAYS=7

# Quality (Phase 7+)
MIN_SHORT_EDGE_PX=512
MAX_UPLOAD_MB=30
API_KEY=

# Optional GPU (Linux + NVIDIA)
# NVIDIA_VISIBLE_DEVICES=all
